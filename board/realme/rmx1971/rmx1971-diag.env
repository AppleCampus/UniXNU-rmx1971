# Diagnostic environment: storage and partition reconnaissance.
#
# Read-only from start to finish -- no writes, no formatting, no boot attempt.
# The handset has no usable input (stdin is serial,button-kbd, and the serial
# port of a retail unit is not wired out), so every experiment has to be baked
# into the default environment and run unattended; each flash cycle is one
# photograph of the screen.
#
# Output is paged on purpose: a framebuffer console has no scrollback, so the
# short list goes first, then `pause` waits for a volume key (button-kbd feeds
# getchar()) before the full GPT dump, which is 40-60 lines and would otherwise
# push the useful part off the top.
bootdelay=2
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 diag

# Page 1. `scsi info` restates the LUN geometry the probe log already showed;
# the `part size` lines answer "does the partition I plan to use exist, and how
# big is it" without the length of a full dump; fatls then proves the modem
# partition really is FAT and reachable through the 4 KiB-block mismatch path --
# that is the candidate drop point for UniXNU.efi if we would rather not invent
# a filesystem of our own.
bootcmd=echo === diag 1/2; scsi info; echo --- size by name; part size scsi 0:boot; part size scsi 0:dtbo; part size scsi 0:vbmeta; part size scsi 0:misc; part size scsi 0:modem; part size scsi 0:persist; part size scsi 0:super; part size scsi 0:userdata; echo --- fat probe; part number scsi 0 modem mp; fatls scsi 0:${mp} /; echo === press a volume key for the full GPT; pause; echo === diag 2/2; part list scsi 0; echo === diag end; sleep 20; reset
