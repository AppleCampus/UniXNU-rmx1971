# Diagnostic environment v3: where is the firmware that the GPT does not name?
#
# v2 settled the table on LUN0: fourteen entries, ssd / persist / misc /
# keystore / frp / vm-keystore / vm-data / vm-system / vm-linux / cache /
# system / vendor / odm / userdata, ending at LBA 0xeaa7f3 of a 0xeaa800-LUN --
# the table covers the whole LUN. There is no boot, dtbo, vbmeta, modem or xbl
# in it, yet fstab.qcom references modem/dsp/bluetooth and this ABL flashes
# boot images by name, so the bootloader resolves a partition list that this
# GPT does not contain.
#
# Two candidate explanations, both checkable read-only:
#  1. the firmware partitions live on the other LUNs (scsi 1..3, the 4 MiB
#     ones), which would need their own GPT at LBA 1;
#  2. there is a second, 512-byte-sector GPT on LUN0 with its header at
#     physical byte 512 -- inside U-Boot's LBA 0, right after the protective
#     MBR. A bootloader that assumes 512-byte LBAs would read that table and
#     never see the 4 KiB one; a 4 KiB reader sees the opposite. Reading LBA 0
#     and dumping the eight bytes at offset 0x200 answers it in one line.
# Also dump the 4 KiB GPT header itself (first 0x60 bytes) so backup_lba,
# partition_entry_lba and the entry count can be compared against whatever else
# turns up. Everything here is read-only.
bootdelay=2
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 diag v3

# Partition lists of the three small LUNs, then their LBA-1 magic.
diag_luns=part list scsi 1 pl1;echo p1=$pl1;part list scsi 2 pl2;echo p2=$pl2;part list scsi 3 pl3;echo p3=$pl3
diag_magic=scsi dev 1;scsi read 0xa0000000 1 1;md.b 0xa0000000 8;scsi dev 2;scsi read 0xa0000000 1 1;md.b 0xa0000000 8;scsi dev 3;scsi read 0xa0000000 1 1;md.b 0xa0000000 8

# LUN0: byte 512 of LBA 0 (a 512-sector GPT header would announce itself here),
# then the first 0x60 bytes of the 4 KiB GPT header at LBA 1.
diag_hdr=scsi dev 0;scsi read 0xa0000000 0 1;md.b 0xa0000200 8;scsi read 0xa0001000 1 1;md.b 0xa0001000 0x60

# Same six firmware names on the small LUNs, in case one of them does carry a
# table; a failed lookup prints an empty slot and leaves no stale value.
diag_names=setenv a;setenv b;part number scsi 1 boot a;part size scsi 1 boot b;echo l1boot=$a,$b;setenv a;setenv b;part number scsi 1 vbmeta a;part size scsi 1 vbmeta b;echo l1vbmeta=$a,$b;setenv a;setenv b;part number scsi 1 xbl a;part size scsi 1 xbl b;echo l1xbl=$a,$b;setenv a;setenv b;part number scsi 2 boot a;part size scsi 2 boot b;echo l2boot=$a,$b;setenv a;setenv b;part number scsi 2 xbl a;part size scsi 2 xbl b;echo l2xbl=$a,$b;setenv a;setenv b;part number scsi 3 boot a;part size scsi 3 boot b;echo l3boot=$a,$b

bootcmd=echo === luns;run diag_luns;echo === lba1 small luns;run diag_magic;echo === lun0 hdr;run diag_hdr;echo === names;run diag_names;echo === end;sleep 30;reset
