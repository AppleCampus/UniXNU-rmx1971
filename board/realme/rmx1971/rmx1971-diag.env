# Diagnostic environment v2: what the partitions are actually called.
#
# v1 asked for boot / dtbo / vbmeta / modem / super / metadata by name and got
# nothing back, while misc (3), persist (2), frp (5) and userdata (14) all
# resolved with sensible sizes. That combination -- the four names that are
# never A/B slotted resolve, the three that always are do not -- means the GPT
# uses slotted names (boot_a, dtbo_a, vbmeta_a, ...) and my guesses were wrong.
# v1 also printed the *previous* partition's number and size on every failed
# lookup: do_part_info() bails out before env_set() on error, so a stale value
# survives. Anything that reads a partition into a variable has to clear it
# first, which is what the setenv <var> with no value in front of every lookup
# is doing.
#
# Evidence that the table itself is fine, from v1 page 2:
#   scsi read ..., block # 1 -> 45 46 49 20 50 41 52 54  "EFI PART"
# so the GPT is at 4 KiB LBAs, exactly where U-Boot 4 KiB block size expects it.
#
# This image walks the table by index instead of by name: 1..40, three fields
# each -- name, start LBA, size in LBAs (all hex, x4096 for bytes). Two entries
# per output line, because the console is 70x76 with no scrollback and the boot
# log already eats 20 rows.
bootdelay=2
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 diag v2

d10=setenv n01;setenv s01;setenv z01;part name scsi 0 1 n01;part start scsi 0 1 s01;part size scsi 0 1 z01;setenv n02;setenv s02;setenv z02;part name scsi 0 2 n02;part start scsi 0 2 s02;part size scsi 0 2 z02;echo 1=$n01,$s01,$z01 2=$n02,$s02,$z02;setenv n03;setenv s03;setenv z03;part name scsi 0 3 n03;part start scsi 0 3 s03;part size scsi 0 3 z03;setenv n04;setenv s04;setenv z04;part name scsi 0 4 n04;part start scsi 0 4 s04;part size scsi 0 4 z04;echo 3=$n03,$s03,$z03 4=$n04,$s04,$z04;setenv n05;setenv s05;setenv z05;part name scsi 0 5 n05;part start scsi 0 5 s05;part size scsi 0 5 z05;setenv n06;setenv s06;setenv z06;part name scsi 0 6 n06;part start scsi 0 6 s06;part size scsi 0 6 z06;echo 5=$n05,$s05,$z05 6=$n06,$s06,$z06;setenv n07;setenv s07;setenv z07;part name scsi 0 7 n07;part start scsi 0 7 s07;part size scsi 0 7 z07;setenv n08;setenv s08;setenv z08;part name scsi 0 8 n08;part start scsi 0 8 s08;part size scsi 0 8 z08;echo 7=$n07,$s07,$z07 8=$n08,$s08,$z08;setenv n09;setenv s09;setenv z09;part name scsi 0 9 n09;part start scsi 0 9 s09;part size scsi 0 9 z09;setenv n10;setenv s10;setenv z10;part name scsi 0 10 n10;part start scsi 0 10 s10;part size scsi 0 10 z10;echo 9=$n09,$s09,$z09 10=$n10,$s10,$z10

d20=setenv n11;setenv s11;setenv z11;part name scsi 0 11 n11;part start scsi 0 11 s11;part size scsi 0 11 z11;setenv n12;setenv s12;setenv z12;part name scsi 0 12 n12;part start scsi 0 12 s12;part size scsi 0 12 z12;echo 11=$n11,$s11,$z11 12=$n12,$s12,$z12;setenv n13;setenv s13;setenv z13;part name scsi 0 13 n13;part start scsi 0 13 s13;part size scsi 0 13 z13;setenv n14;setenv s14;setenv z14;part name scsi 0 14 n14;part start scsi 0 14 s14;part size scsi 0 14 z14;echo 13=$n13,$s13,$z13 14=$n14,$s14,$z14;setenv n15;setenv s15;setenv z15;part name scsi 0 15 n15;part start scsi 0 15 s15;part size scsi 0 15 z15;setenv n16;setenv s16;setenv z16;part name scsi 0 16 n16;part start scsi 0 16 s16;part size scsi 0 16 z16;echo 15=$n15,$s15,$z15 16=$n16,$s16,$z16;setenv n17;setenv s17;setenv z17;part name scsi 0 17 n17;part start scsi 0 17 s17;part size scsi 0 17 z17;setenv n18;setenv s18;setenv z18;part name scsi 0 18 n18;part start scsi 0 18 s18;part size scsi 0 18 z18;echo 17=$n17,$s17,$z17 18=$n18,$s18,$z18;setenv n19;setenv s19;setenv z19;part name scsi 0 19 n19;part start scsi 0 19 s19;part size scsi 0 19 z19;setenv n20;setenv s20;setenv z20;part name scsi 0 20 n20;part start scsi 0 20 s20;part size scsi 0 20 z20;echo 19=$n19,$s19,$z19 20=$n20,$s20,$z20

d30=setenv n21;setenv s21;setenv z21;part name scsi 0 21 n21;part start scsi 0 21 s21;part size scsi 0 21 z21;setenv n22;setenv s22;setenv z22;part name scsi 0 22 n22;part start scsi 0 22 s22;part size scsi 0 22 z22;echo 21=$n21,$s21,$z21 22=$n22,$s22,$z22;setenv n23;setenv s23;setenv z23;part name scsi 0 23 n23;part start scsi 0 23 s23;part size scsi 0 23 z23;setenv n24;setenv s24;setenv z24;part name scsi 0 24 n24;part start scsi 0 24 s24;part size scsi 0 24 z24;echo 23=$n23,$s23,$z23 24=$n24,$s24,$z24;setenv n25;setenv s25;setenv z25;part name scsi 0 25 n25;part start scsi 0 25 s25;part size scsi 0 25 z25;setenv n26;setenv s26;setenv z26;part name scsi 0 26 n26;part start scsi 0 26 s26;part size scsi 0 26 z26;echo 25=$n25,$s25,$z25 26=$n26,$s26,$z26;setenv n27;setenv s27;setenv z27;part name scsi 0 27 n27;part start scsi 0 27 s27;part size scsi 0 27 z27;setenv n28;setenv s28;setenv z28;part name scsi 0 28 n28;part start scsi 0 28 s28;part size scsi 0 28 z28;echo 27=$n27,$s27,$z27 28=$n28,$s28,$z28;setenv n29;setenv s29;setenv z29;part name scsi 0 29 n29;part start scsi 0 29 s29;part size scsi 0 29 z29;setenv n30;setenv s30;setenv z30;part name scsi 0 30 n30;part start scsi 0 30 s30;part size scsi 0 30 z30;echo 29=$n29,$s29,$z29 30=$n30,$s30,$z30

d40=setenv n31;setenv s31;setenv z31;part name scsi 0 31 n31;part start scsi 0 31 s31;part size scsi 0 31 z31;setenv n32;setenv s32;setenv z32;part name scsi 0 32 n32;part start scsi 0 32 s32;part size scsi 0 32 z32;echo 31=$n31,$s31,$z31 32=$n32,$s32,$z32;setenv n33;setenv s33;setenv z33;part name scsi 0 33 n33;part start scsi 0 33 s33;part size scsi 0 33 z33;setenv n34;setenv s34;setenv z34;part name scsi 0 34 n34;part start scsi 0 34 s34;part size scsi 0 34 z34;echo 33=$n33,$s33,$z33 34=$n34,$s34,$z34;setenv n35;setenv s35;setenv z35;part name scsi 0 35 n35;part start scsi 0 35 s35;part size scsi 0 35 z35;setenv n36;setenv s36;setenv z36;part name scsi 0 36 n36;part start scsi 0 36 s36;part size scsi 0 36 z36;echo 35=$n35,$s35,$z35 36=$n36,$s36,$z36;setenv n37;setenv s37;setenv z37;part name scsi 0 37 n37;part start scsi 0 37 s37;part size scsi 0 37 z37;setenv n38;setenv s38;setenv z38;part name scsi 0 38 n38;part start scsi 0 38 s38;part size scsi 0 38 z38;echo 37=$n37,$s37,$z37 38=$n38,$s38,$z38;setenv n39;setenv s39;setenv z39;part name scsi 0 39 n39;part start scsi 0 39 s39;part size scsi 0 39 z39;setenv n40;setenv s40;setenv z40;part name scsi 0 40 n40;part start scsi 0 40 s40;part size scsi 0 40 z40;echo 39=$n39,$s39,$z39 40=$n40,$s40,$z40

bootcmd=echo === part names;part list scsi 0 pl;echo pl=$pl;run d10;run d20;run d30;run d40;echo === end;sleep 30;reset
