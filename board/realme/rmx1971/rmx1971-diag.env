# Diagnostic environment: storage and partition reconnaissance.
#
# Read-only from start to finish -- no writes, no formatting, no boot attempt.
# The handset has no usable input (stdin is serial,button-kbd, and the serial
# port of a retail unit is not wired out), so every experiment has to be baked
# into the default environment and run unattended: each flash cycle buys one
# photograph of the screen. Hence a script that answers as much as possible.
#
# Why not `part list`: part_print_efi() emits four lines per entry (name, attrs,
# type GUID, partition GUID), and this device has around fifty partitions -- two
# hundred lines on a console that holds seventy-odd and has no scrollback. The
# table below asks for the ten partitions that matter by name and prints one
# line each, so a missing entry costs one line instead of shifting everything.
bootdelay=2
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 diag

# Page 1: does the GPT parse at all, and where do the partitions we care about
# live. `part number` and `part size` both resolve names, so an entry that does
# not exist prints an error and leaves the variables empty -- visible, and it
# does not disturb the lines around it. Values are hex LBAs of 4096 bytes.
diag_sizes=part number scsi 0 boot a;part size scsi 0 boot b;echo boot $a $b;part number scsi 0 dtbo a;part size scsi 0 dtbo b;echo dtbo $a $b;part number scsi 0 vbmeta a;part size scsi 0 vbmeta b;echo vbmeta $a $b;part number scsi 0 misc a;part size scsi 0 misc b;echo misc $a $b;part number scsi 0 persist a;part size scsi 0 persist b;echo persist $a $b;part number scsi 0 modem a;part size scsi 0 modem b;echo modem $a $b;part number scsi 0 super a;part size scsi 0 super b;echo super $a $b;part number scsi 0 userdata a;part size scsi 0 userdata b;echo userdata $a $b;part number scsi 0 metadata a;part size scsi 0 metadata b;echo metadata $a $b;part number scsi 0 frp a;part size scsi 0 frp b;echo frp $a $b

# Page 2: is the modem partition readable as FAT (the only filesystem on this
# device U-Boot can be expected to understand -- /vendor/firmware_mnt is that
# partition mounted vfat), and does the GPT really sit at 4 KiB LBAs. The magic
# dump matters because a table written with 512-byte sectors in mind would put
# "EFI PART" at LBA 0 offset 0x200 instead of LBA 1 offset 0, and U-Boot would
# print no partitions at all with no hint why.
diag_fat=part number scsi 0 modem a;echo modempart=$a;fatls scsi 0:${a} /;echo --- lba1;scsi read 0xa0000000 1 1;md.b 0xa0000000 8;part list scsi 0 -bootable pl;echo bootable=$pl

bootcmd=echo === diag 1/2; run diag_sizes; echo === press a volume key for page 2; pause; echo === diag 2/2; run diag_fat; echo === diag end; sleep 30; reset
