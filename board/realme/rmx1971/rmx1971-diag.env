# Diagnostic environment v6: the firmware LUNs.
#
# LUN4 and LUN5 were always there. The first log I was given ended mid-way
# through Device 3, I read "four LUNs" into it, and then spent several rounds
# trying to explain a device with room for only nineteen partitions. The
# corrected scan shows six LUNs totalling 63.99 GB -- exactly a 64 GB handset --
# and LUN4 (656 MiB) + LUN5 (256 MiB) leave room for the 807.8 MiB of firmware
# that `fastboot getvar all` lists and that LUN0's fourteen-partition table has
# nowhere to put. boot, dtbo, vbmeta, modem, dsp, recovery and the rest live here.
#
# This walks both LUNs by index, then resolves the name "boot" on each and reads
# its first block: the image we just flashed starts with "ANDROID!", so the
# hexdump doubles as proof that U-Boot can read the very partition the ABL boots
# us from -- which is what S2 needs in order to place a payload inside it.
#
# scsi scan stays out of preboot on purpose: three lines per LUN times six LUNs
# pushes everything else off a console that has 76 rows and no scrollback.
# Touching scsi 4 triggers the scan implicitly anyway.
bootdelay=1
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 diag v6

# Split in two: one single env var of 5000 characters is a longer `run` string
# than anything exercised so far, and a truncated script here would look exactly
# like a missing partition.
diag_l4a=part list scsi 4 pl4;echo p4=$pl4;setenv n4_1;setenv s4_1;setenv z4_1;part name scsi 4 1 n4_1;part start scsi 4 1 s4_1;part size scsi 4 1 z4_1;setenv n4_2;setenv s4_2;setenv z4_2;part name scsi 4 2 n4_2;part start scsi 4 2 s4_2;part size scsi 4 2 z4_2;echo 1=$n4_1,$s4_1,$z4_1 2=$n4_2,$s4_2,$z4_2;setenv n4_3;setenv s4_3;setenv z4_3;part name scsi 4 3 n4_3;part start scsi 4 3 s4_3;part size scsi 4 3 z4_3;setenv n4_4;setenv s4_4;setenv z4_4;part name scsi 4 4 n4_4;part start scsi 4 4 s4_4;part size scsi 4 4 z4_4;echo 3=$n4_3,$s4_3,$z4_3 4=$n4_4,$s4_4,$z4_4;setenv n4_5;setenv s4_5;setenv z4_5;part name scsi 4 5 n4_5;part start scsi 4 5 s4_5;part size scsi 4 5 z4_5;setenv n4_6;setenv s4_6;setenv z4_6;part name scsi 4 6 n4_6;part start scsi 4 6 s4_6;part size scsi 4 6 z4_6;echo 5=$n4_5,$s4_5,$z4_5 6=$n4_6,$s4_6,$z4_6;setenv n4_7;setenv s4_7;setenv z4_7;part name scsi 4 7 n4_7;part start scsi 4 7 s4_7;part size scsi 4 7 z4_7;setenv n4_8;setenv s4_8;setenv z4_8;part name scsi 4 8 n4_8;part start scsi 4 8 s4_8;part size scsi 4 8 z4_8;echo 7=$n4_7,$s4_7,$z4_7 8=$n4_8,$s4_8,$z4_8;setenv n4_9;setenv s4_9;setenv z4_9;part name scsi 4 9 n4_9;part start scsi 4 9 s4_9;part size scsi 4 9 z4_9;setenv n4_10;setenv s4_10;setenv z4_10;part name scsi 4 10 n4_10;part start scsi 4 10 s4_10;part size scsi 4 10 z4_10;echo 9=$n4_9,$s4_9,$z4_9 10=$n4_10,$s4_10,$z4_10;setenv n4_11;setenv s4_11;setenv z4_11;part name scsi 4 11 n4_11;part start scsi 4 11 s4_11;part size scsi 4 11 z4_11;setenv n4_12;setenv s4_12;setenv z4_12;part name scsi 4 12 n4_12;part start scsi 4 12 s4_12;part size scsi 4 12 z4_12;echo 11=$n4_11,$s4_11,$z4_11 12=$n4_12,$s4_12,$z4_12;setenv n4_13;setenv s4_13;setenv z4_13;part name scsi 4 13 n4_13;part start scsi 4 13 s4_13;part size scsi 4 13 z4_13;setenv n4_14;setenv s4_14;setenv z4_14;part name scsi 4 14 n4_14;part start scsi 4 14 s4_14;part size scsi 4 14 z4_14;echo 13=$n4_13,$s4_13,$z4_13 14=$n4_14,$s4_14,$z4_14;setenv n4_15;setenv s4_15;setenv z4_15;part name scsi 4 15 n4_15;part start scsi 4 15 s4_15;part size scsi 4 15 z4_15;setenv n4_16;setenv s4_16;setenv z4_16;part name scsi 4 16 n4_16;part start scsi 4 16 s4_16;part size scsi 4 16 z4_16;echo 15=$n4_15,$s4_15,$z4_15 16=$n4_16,$s4_16,$z4_16;setenv n4_17;setenv s4_17;setenv z4_17;part name scsi 4 17 n4_17;part start scsi 4 17 s4_17;part size scsi 4 17 z4_17;setenv n4_18;setenv s4_18;setenv z4_18;part name scsi 4 18 n4_18;part start scsi 4 18 s4_18;part size scsi 4 18 z4_18;echo 17=$n4_17,$s4_17,$z4_17 18=$n4_18,$s4_18,$z4_18
diag_l4b=setenv n4_19;setenv s4_19;setenv z4_19;part name scsi 4 19 n4_19;part start scsi 4 19 s4_19;part size scsi 4 19 z4_19;setenv n4_20;setenv s4_20;setenv z4_20;part name scsi 4 20 n4_20;part start scsi 4 20 s4_20;part size scsi 4 20 z4_20;echo 19=$n4_19,$s4_19,$z4_19 20=$n4_20,$s4_20,$z4_20;setenv n4_21;setenv s4_21;setenv z4_21;part name scsi 4 21 n4_21;part start scsi 4 21 s4_21;part size scsi 4 21 z4_21;setenv n4_22;setenv s4_22;setenv z4_22;part name scsi 4 22 n4_22;part start scsi 4 22 s4_22;part size scsi 4 22 z4_22;echo 21=$n4_21,$s4_21,$z4_21 22=$n4_22,$s4_22,$z4_22;setenv n4_23;setenv s4_23;setenv z4_23;part name scsi 4 23 n4_23;part start scsi 4 23 s4_23;part size scsi 4 23 z4_23;setenv n4_24;setenv s4_24;setenv z4_24;part name scsi 4 24 n4_24;part start scsi 4 24 s4_24;part size scsi 4 24 z4_24;echo 23=$n4_23,$s4_23,$z4_23 24=$n4_24,$s4_24,$z4_24;setenv n4_25;setenv s4_25;setenv z4_25;part name scsi 4 25 n4_25;part start scsi 4 25 s4_25;part size scsi 4 25 z4_25;setenv n4_26;setenv s4_26;setenv z4_26;part name scsi 4 26 n4_26;part start scsi 4 26 s4_26;part size scsi 4 26 z4_26;echo 25=$n4_25,$s4_25,$z4_25 26=$n4_26,$s4_26,$z4_26;setenv n4_27;setenv s4_27;setenv z4_27;part name scsi 4 27 n4_27;part start scsi 4 27 s4_27;part size scsi 4 27 z4_27;setenv n4_28;setenv s4_28;setenv z4_28;part name scsi 4 28 n4_28;part start scsi 4 28 s4_28;part size scsi 4 28 z4_28;echo 27=$n4_27,$s4_27,$z4_27 28=$n4_28,$s4_28,$z4_28;setenv n4_29;setenv s4_29;setenv z4_29;part name scsi 4 29 n4_29;part start scsi 4 29 s4_29;part size scsi 4 29 z4_29;setenv n4_30;setenv s4_30;setenv z4_30;part name scsi 4 30 n4_30;part start scsi 4 30 s4_30;part size scsi 4 30 z4_30;echo 29=$n4_29,$s4_29,$z4_29 30=$n4_30,$s4_30,$z4_30;setenv n4_31;setenv s4_31;setenv z4_31;part name scsi 4 31 n4_31;part start scsi 4 31 s4_31;part size scsi 4 31 z4_31;setenv n4_32;setenv s4_32;setenv z4_32;part name scsi 4 32 n4_32;part start scsi 4 32 s4_32;part size scsi 4 32 z4_32;echo 31=$n4_31,$s4_31,$z4_31 32=$n4_32,$s4_32,$z4_32;setenv n4_33;setenv s4_33;setenv z4_33;part name scsi 4 33 n4_33;part start scsi 4 33 s4_33;part size scsi 4 33 z4_33;setenv n4_34;setenv s4_34;setenv z4_34;part name scsi 4 34 n4_34;part start scsi 4 34 s4_34;part size scsi 4 34 z4_34;echo 33=$n4_33,$s4_33,$z4_33 34=$n4_34,$s4_34,$z4_34;setenv n4_35;setenv s4_35;setenv z4_35;part name scsi 4 35 n4_35;part start scsi 4 35 s4_35;part size scsi 4 35 z4_35;setenv n4_36;setenv s4_36;setenv z4_36;part name scsi 4 36 n4_36;part start scsi 4 36 s4_36;part size scsi 4 36 z4_36;echo 35=$n4_35,$s4_35,$z4_35 36=$n4_36,$s4_36,$z4_36
diag_l5=part list scsi 5 pl5;echo p5=$pl5;setenv n5_1;setenv s5_1;setenv z5_1;part name scsi 5 1 n5_1;part start scsi 5 1 s5_1;part size scsi 5 1 z5_1;setenv n5_2;setenv s5_2;setenv z5_2;part name scsi 5 2 n5_2;part start scsi 5 2 s5_2;part size scsi 5 2 z5_2;echo 1=$n5_1,$s5_1,$z5_1 2=$n5_2,$s5_2,$z5_2;setenv n5_3;setenv s5_3;setenv z5_3;part name scsi 5 3 n5_3;part start scsi 5 3 s5_3;part size scsi 5 3 z5_3;setenv n5_4;setenv s5_4;setenv z5_4;part name scsi 5 4 n5_4;part start scsi 5 4 s5_4;part size scsi 5 4 z5_4;echo 3=$n5_3,$s5_3,$z5_3 4=$n5_4,$s5_4,$z5_4;setenv n5_5;setenv s5_5;setenv z5_5;part name scsi 5 5 n5_5;part start scsi 5 5 s5_5;part size scsi 5 5 z5_5;setenv n5_6;setenv s5_6;setenv z5_6;part name scsi 5 6 n5_6;part start scsi 5 6 s5_6;part size scsi 5 6 z5_6;echo 5=$n5_5,$s5_5,$z5_5 6=$n5_6,$s5_6,$z5_6;setenv n5_7;setenv s5_7;setenv z5_7;part name scsi 5 7 n5_7;part start scsi 5 7 s5_7;part size scsi 5 7 z5_7;setenv n5_8;setenv s5_8;setenv z5_8;part name scsi 5 8 n5_8;part start scsi 5 8 s5_8;part size scsi 5 8 z5_8;echo 7=$n5_7,$s5_7,$z5_7 8=$n5_8,$s5_8,$z5_8;setenv n5_9;setenv s5_9;setenv z5_9;part name scsi 5 9 n5_9;part start scsi 5 9 s5_9;part size scsi 5 9 z5_9;setenv n5_10;setenv s5_10;setenv z5_10;part name scsi 5 10 n5_10;part start scsi 5 10 s5_10;part size scsi 5 10 z5_10;echo 9=$n5_9,$s5_9,$z5_9 10=$n5_10,$s5_10,$z5_10;setenv n5_11;setenv s5_11;setenv z5_11;part name scsi 5 11 n5_11;part start scsi 5 11 s5_11;part size scsi 5 11 z5_11;setenv n5_12;setenv s5_12;setenv z5_12;part name scsi 5 12 n5_12;part start scsi 5 12 s5_12;part size scsi 5 12 z5_12;echo 11=$n5_11,$s5_11,$z5_11 12=$n5_12,$s5_12,$z5_12;setenv n5_13;setenv s5_13;setenv z5_13;part name scsi 5 13 n5_13;part start scsi 5 13 s5_13;part size scsi 5 13 z5_13;setenv n5_14;setenv s5_14;setenv z5_14;part name scsi 5 14 n5_14;part start scsi 5 14 s5_14;part size scsi 5 14 z5_14;echo 13=$n5_13,$s5_13,$z5_13 14=$n5_14,$s5_14,$z5_14;setenv n5_15;setenv s5_15;setenv z5_15;part name scsi 5 15 n5_15;part start scsi 5 15 s5_15;part size scsi 5 15 z5_15;setenv n5_16;setenv s5_16;setenv z5_16;part name scsi 5 16 n5_16;part start scsi 5 16 s5_16;part size scsi 5 16 z5_16;echo 15=$n5_15,$s5_15,$z5_15 16=$n5_16,$s5_16,$z5_16
diag_boot=setenv s4_b;part start scsi 4 boot s4_b;echo L4boot_at=$s4_b;scsi dev 4;scsi read 0xa0000000 ${s4_b} 1;md.b 0xa0000000 16;setenv s5_b;part start scsi 5 boot s5_b;echo L5boot_at=$s5_b;scsi dev 5;scsi read 0xa0000000 ${s5_b} 1;md.b 0xa0000000 16

bootcmd=echo === lun4;run diag_l4a;run diag_l4b;echo === lun5;run diag_l5;echo === boot part;run diag_boot;echo === end;sleep 40;reset
