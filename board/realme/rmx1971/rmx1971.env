bootdelay=1
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

kernel_addr_r=0x80080000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000

# UFS shows up as a SCSI device; without a scan there are no partitions at all.
# The scan is no longer in preboot: it prints three lines per LUN, this device
# has six LUNs, and bootcmd's own scsi access triggers it anyway.
preboot=echo; echo RMX1971 U-Boot

# Boot the payload from the logfs partition.
#
# logfs is 8 MiB at LUN4 LBA 0x19391 -- a firmware partition the ABL resolves by
# name, so a payload is installed with one command and no firmware rebuild:
#
#     fastboot flash logfs UniXNU.efi
#
# That is the point of this environment: the payload is replaced in a minute,
# the boot chain stays put.
#
# 0x400 blocks is 4 MiB, and bootefi needs the size given explicitly because a
# bare `bootefi <addr>` only accepts addresses the EFI loader itself recorded --
# an image pulled in with `scsi read` is unknown to it, and it answers "No UEFI
# binary known at ...". The size is an upper bound for PE parsing rather than
# the file length, so one constant covers every payload that fits.
#
# When logfs holds no PE image the loader says so, the boot manager runs next
# and fails in the usual way, and the prompt stays up for a photograph.
bootcmd=echo === payload: logfs;scsi dev 4;scsi read 0xa0000000 0x19391 400;md.b 0xa0000000 16;bootefi 0xa0000000:400000;echo === payload did not run, trying the boot manager;bootefi bootmgr

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=UEFI boot manager=bootefi bootmgr
bootmenu_1=U-Boot prompt=echo at the prompt
