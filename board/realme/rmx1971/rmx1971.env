bootdelay=3
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

kernel_addr_r=0x80080000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000

# UFS shows up as a SCSI device; without the scan the boot menu sees nothing.
preboot=echo; echo RMX1971 U-Boot; scsi scan

# Nothing to boot yet: fall through to the boot manager, fail, and stay at the
# prompt so the log can be photographed.
bootcmd=bootefi bootmgr

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=UEFI boot manager=bootefi bootmgr
bootmenu_1=U-Boot prompt=echo at the prompt
