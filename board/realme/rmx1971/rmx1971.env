bootdelay=1
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

kernel_addr_r=0x80080000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000

# UFS shows up as a SCSI device; without a scan there are no partitions at all.
# The scan is no longer in preboot: it prints three lines per LUN, this device
# has six LUNs, and bootcmd's own scsi access triggers it anyway.
preboot=echo; echo RMX1971 U-Boot

# Two ways in, in this order.
#
# 1. The EFI boot manager. It walks the block devices, finds a FAT partition and
#    runs \EFI\BOOT\BOOTAA64.EFI, with the payload volume on vm-system
#    (128 MiB, LUN0 entry 8) rather than a vendor partition. This
#    is the path UniXNU itself expects, because the application loads
#    \EFI\UniXNU\unixnu.toml and the kernel from the volume it was started from.
#
# 2. A bare PE image at the start of logfs (8 MiB, LUN4 LBA 0x19391). Useful
#    while the payload is a single file: `fastboot flash logfs UniXNU.efi`.
#
# bootefi needs the size spelled out for the raw path. A bare `bootefi <addr>`
# only accepts addresses the EFI loader itself recorded, so an image pulled in
# with `scsi read` is unknown to it and it answers "No UEFI binary known at ...".
# The size is an upper bound for PE parsing rather than the file length, so one
# constant covers every payload that fits.
bootcmd=echo === uefi boot manager;bootefi bootmgr;echo === raw payload: logfs;scsi dev 4;scsi read 0xa0000000 0x19391 400;md.b 0xa0000000 16;bootefi 0xa0000000:400000;echo === nothing booted, staying at the prompt

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=UEFI boot manager=bootefi bootmgr
bootmenu_1=U-Boot prompt=echo at the prompt
