# Realme 5 Pro (RMX1971) deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as kconfig fragments: make qcom_defconfig qcom-phone.config rmx1971.config

CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/realme/rmx1971/rmx1971.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024

# The arm64 Image header in front of the payload must report a text offset of
# zero, or this ABL loads U-Boot 2 GiB below RAM and the handset sits on the
# splash with no output and no reset. That value is not set here: a kconfig
# fragment cannot carry it (merge_config splices the explanatory comment into the
# assignment and kconfig drops the result), so scripts/build-in-tree.sh sets it
# on the generated .config and fails the build if it did not take.

# UEFI: this is what UniXNU actually needs. Everything above only exists so
# the firmware can be built and driven at all.
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y

# Console: the ABL leaves its splash at 0x9c000000 and there is no UART on a
# retail unit, so the framebuffer is the only output we get.
CONFIG_VIDEO_SIMPLE=y
# Without this kconfig symbol U-Boot ignores `stdout` from the environment and
# picks the first registered output device, which on a board with no working
# serial port leaves the console unattached.
CONFIG_SYS_CONSOLE_IS_IN_ENV=y

# Storage: UFS, not eMMC.
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI=y

# Partition tables. The UFS LUN hands out 4 KiB logical blocks and Android
# laid this handset out with GPT, so upstream's defaults (nothing selected on a
# Qualcomm build) are not enough to even name a partition.
CONFIG_EFI_PARTITION=y
CONFIG_CMD_PART=y

# FAT. /vendor/firmware_mnt is the modem partition mounted vfat, so a FAT
# reader is the one filesystem U-Boot can expect to find on this device --
# everything else Android owns is ext4/erofs/F2FS. CMD_FAT selects FS_FAT;
# FS_FAT_HANDLE_SECTOR_SIZE_MISMATCH (already in qcom_defconfig) is what makes
# that work when the FAT metadata says 512-byte sectors but the LUN reports
# 4096.
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y

# U-Boot's own fastboot, over the USB2 gadget. This is the point of the whole
# exercise: the handset cannot be typed at (no UART, no USB host, no touch), so
# a host-side console is the difference between one flash per experiment and a
# live session.
#
# CONFIG_CMD_FASTBOOT, USB_DWC3_GADGET and USB_FUNCTION_FASTBOOT already come
# from qcom_defconfig; what is missing is a usable flash backend. The default
# selection is FASTBOOT_FLASH_MMC and there is no MMC here -- storage is UFS
# behind the SCSI layer. FASTBOOT_FLASH_BLOCK is in the same choice group, so it
# has to replace MMC rather than join it.
#
# With CONFIG_FASTBOOT_OEM_RUN (on via qcom-phone.config) `fastboot oem run
# <command>` executes any U-Boot command, and with CONFIG_CONSOLE_RECORD +
# CONFIG_FASTBOOT_CMD_OEM_CONSOLE `fastboot oem console` reads the recorded
# output back over the cable. That pair turns the handset into something a shell
# can drive.
# CONFIG_FASTBOOT_FLASH_MMC is not set
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
