# Realme 5 Pro (RMX1971) deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as kconfig fragments: make qcom_defconfig qcom-phone.config rmx1971.config

CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/realme/rmx1971/rmx1971.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024

# The arm64 Image header U-Boot puts in front of the payload carries
# TEXT_OFFSET = CONFIG_TEXT_BASE - CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE
# (arch/arm/cpu/armv8/linux-kernel-image-header-vars.h). qcom_defconfig builds
# position independent, so TEXT_BASE is 0, while mach-snapdragon defaults the
# base to 0x80000000 -- which yields a TEXT_OFFSET of -0x80000000, i.e. a load
# address 2 GiB *below* the base kernel load address. This ABL reads that field
# (the working iOS shim on this handset ships text_offset = 0), so U-Boot never
# gets control and the handset sits on the splash with nothing to reset it.
# Setting the base to 0 makes TEXT_OFFSET 0, the value every other arm64 image
# on this device uses.
CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x0

# UEFI: this is what UniXNU actually needs. Everything above only exists so
# the firmware can be built and driven at all.
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y

# Console: the ABL leaves its splash at 0x9c000000 and there is no UART on a
# retail unit, so the framebuffer is the only output we get.
CONFIG_VIDEO_SIMPLE=y
# Without this kconfig symbol U-Boot ignores `stdout` from the environment and
# picks the first registered output device, which on a board with no working
# serial port leaves the console unattached.
CONFIG_SYS_CONSOLE_IS_IN_ENV=y

# Storage: UFS, not eMMC.
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI=y
