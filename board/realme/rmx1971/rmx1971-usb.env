# USB environment: hand the board over to U-Boot's own fastboot.
#
# Until now every experiment cost a flash cycle and a photograph. The console
# record and the fastboot gadget are both compiled in, so the board can instead
# spend its whole life in fastboot and be driven from the host:
#
#   fastboot devices
#   fastboot oem run "part list scsi 0"   -- any U-Boot command
#   fastboot oem console                  -- read back what it printed
#   fastboot flash cache <file>           -- write, via the SCSI block backend
#   fastboot reboot                       -- leave
#
# `scsi scan` stays in preboot so the partition names fastboot resolves come
# from the same table every other command sees.
bootdelay=1
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 usb; scsi scan

# Blocks until the host detaches. If the gadget never comes up the handset sits
# on this line, which is itself the diagnosis: the screen keeps the last output
# visible and a long press on the power key restarts it.
bootcmd=echo === fastboot over usb; fastboot usb 0; echo fastboot exited; sleep 3; reset
