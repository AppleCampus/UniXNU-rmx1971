# Probe environment: no storage scan, no video dependence, just proof of life.
#
# Flash this when the screen shows nothing. If U-Boot executes at all it reaches
# bootcmd, waits 15 s and resets the board, so the handset reboots on its own
# ~17 s after the splash appears. A handset that sits on the logo forever means
# the CPU never got to bootcmd -- either ABL did not jump or U-Boot died before
# the console existed.
bootdelay=2
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo probe: preboot reached

# reset goes through PSHOLD (CONFIG_SYSRESET_QCOM_PSHOLD), which needs no
# display and no storage driver.
bootcmd=echo probe: u-boot is running, resetting in 15s; sleep 15; reset
