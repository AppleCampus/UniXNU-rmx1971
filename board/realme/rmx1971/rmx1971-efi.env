# EFI environment: run the payload the ABL wrote into a firmware partition.
#
# The chain this exercises, in order:
#   fastboot flash logfs hello.efi   -> ABL resolves "logfs" and writes it raw
#   scsi read ... 0x19391            -> U-Boot reads that partition by LBA
#   bootefi 0xa0000000               -> EFI_LOADER relocates the PE32+ image
#
# logfs is 8 MiB at LUN4 LBA 0x19391 -- measured, not guessed; `part list scsi 4`
# printed it, and the LUN4 table is fixed. It holds a kernel log on a stock
# handset and nothing at all in this project, which makes it the disposable
# landing pad for the first payload test. boot (0xc505) stays untouched: it is
# the partition the ABL boots us from and it is working.
bootdelay=1
bootretry=-1

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

preboot=echo; echo RMX1971 efi

# Eight blocks is 32 KiB, more than the whole hello.efi; reading a fixed amount
# keeps the command line free of arithmetic. The hexdump is the MZ check: a
# wrong LBA shows zeros or someone else's data instead of 4d 5a.
bootcmd=echo === logfs payload;scsi dev 4;scsi read 0xa0000000 0x19391 8;md.b 0xa0000000 32;echo === bootefi;bootefi 0xa0000000;echo === after bootefi;sleep 40;reset
